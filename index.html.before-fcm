<!DOCTYPE html>
<html lang="pt-MZ" data-theme="noir">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Lumière Life Manager</title>
  <link rel="stylesheet" href="CSS/fonts.css?v=5">
  <link rel="stylesheet" href="CSS/main.css?v=5">
  <link rel="stylesheet" href="CSS/splash.css?v=21">
  <link rel="stylesheet" href="pages/tasks/tasks.css">
  <link rel="stylesheet" href="pages/habits/habits.css">
  <link rel="stylesheet" href="pages/goals/goals.css">
  <link rel="stylesheet" href="pages/studies/studies.css">
  <link rel="stylesheet" href="pages/lumiere/lumiere.css">
  <link rel="stylesheet" href="pages/notes/notes.css">
  <link rel="stylesheet" href="pages/calendar/calendar.css">
  <link rel="stylesheet" href="pages/finances/finances.css">
  <link rel="stylesheet" href="pages/settings/settings.css">
  <link rel="stylesheet" href="pages/cards/overview/overview.css">
  <link rel="stylesheet" href="pages/profile/profile.css">
  <link rel="stylesheet" href="components/cards/card.css">
  <link rel="stylesheet" href="pages/cards/progress/progress.css">
  <link rel="stylesheet" href="pages/cards/mainGoal/mainGoal.css">
  <link rel="stylesheet" href="pages/cards/lumiere/lumiere.css">
  <link rel="stylesheet" href="pages/cards/finances/finances.css">
  <link rel="stylesheet" href="pages/cards/today/today.css">
  <link rel="stylesheet" href="pages/cards/weeklyProgress/weeklyProgress.css">
  <link rel="stylesheet" href="pages/cards/insights/insights.css">
  <link rel="stylesheet" href="pages/cards/reports/reports.css">
  <link rel="stylesheet" href="components/context-line/contextLine.css">
  <link rel="stylesheet" href="components/progress-ring/progressRing.css">
  <link rel="stylesheet" href="components/stat-row/statRow.css">
  <link rel="stylesheet" href="components/mini-card/miniCard.css">
  <link rel="stylesheet" href="components/sheet/sheet.css">
  <link rel="stylesheet" href="components/bar-chart/barChart.css">
  <link rel="stylesheet" href="components/line-chart/lineChart.css">
  <link rel="stylesheet" href="components/empty-state/emptyState.css">
  <link rel="stylesheet" href="components/menu/menu.css">
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" type="image/svg+xml" href="public/brand/master/lumiere-mark-v1-raw.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="public/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="public/icons/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="public/icons/apple-touch-icon.png">
  <link rel="shortcut icon" href="public/icons/favicon.ico">
  <script id="lumiere-theme-init">
    // Aplica o tema guardado antes de a página pintar (evita flash)
    (function() {
      try {
        var raw = localStorage.getItem('lumierePreferences');
        if (raw) {
          var prefs = JSON.parse(raw);
          var theme = prefs && prefs.theme ? prefs.theme : 'noir';
          document.documentElement.setAttribute('data-theme', theme);
        }
      } catch (e) { /* ignorar */ }
    })();
  </script>
</head>
<body>
  <noscript>
    <div style="position:fixed;inset:0;background:#0a0a0a;color:#d4af37;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;padding:2rem;text-align:center;z-index:9999;">
      <div>
        <h1 style="font-size:1.5rem;margin-bottom:1rem;">Lumière Life Manager</h1>
        <p style="color:#f5f0eb;">Este aplicativo precisa de JavaScript para funcionar.</p>
        <p style="color:#b8956a;font-size:0.9rem;margin-top:0.5rem;">Ativa o JavaScript no teu navegador e recarrega a página.</p>
      </div>
    </div>
  </noscript>

  <!-- Splash Screen (F11-B001) -->
  <div id="splash" class="splash" role="status" aria-label="A carregar">
    <img src="public/brand/master/lumiere-mark-symbol.svg" alt="" class="splash__symbol">
    <h1 class="splash__wordmark">LUMIÈRE</h1>
    <hr class="splash__divider">
    <p class="splash__subtitle">Life Manager</p>
    <div class="splash__loader" aria-hidden="true">
      <div class="splash__loader-bar"></div>
    </div>
    <p class="splash__hint">A carregar</p>
  </div>

  <!-- VIEW 1: Onboarding -->
  <div id="app">
    <div class="onboarding" id="onboarding">
      <h1>LUMIÈRE</h1>
      <div class="subtitle">Life Manager</div>

      <div id="step-1" class="step active">
        <p style="text-align:center;color:var(--color-text-secondary);margin-bottom:1.5rem;">Bem-vindo ao seu gestor pessoal.</p>
        <button id="btn-start">COMEÇAR</button>
      </div>

      <div id="step-2" class="step">
        <label for="userName">Como devemos chamá-lo?</label>
        <input type="text" id="userName" placeholder="Seu nome" autocomplete="name">
        <div id="nameError" class="error">Por favor, insira seu nome.</div>
        <button id="btn-name">CONTINUAR</button>
      </div>

      <div id="step-3" class="step">
        <label for="theme">Tema</label>
        <select id="theme">
          <option value="noir">Noir (escuro)</option>
          <option value="lumiere">Lumière (claro)</option>
          <option value="auto">Automático</option>
        </select>
        <label for="goldIntensity">Intensidade dourada</label>
        <select id="goldIntensity">
          <option value="subtle">Sutil</option>
          <option value="balanced" selected>Equilibrada</option>
          <option value="strong">Forte</option>
        </select>
        <label for="interfaceSize">Tamanho da interface</label>
        <select id="interfaceSize">
          <option value="compact">Compacto</option>
          <option value="balanced" selected>Equilibrado</option>
          <option value="comfortable">Confortável</option>
        </select>
        <button id="btn-personalize">PRÓXIMO</button>
      </div>

      <div id="step-4" class="step">
        <div id="summary"></div>
        <button id="btn-finish">COMEÇAR A USAR</button>
      </div>
    </div>
  </div>

  <!-- VIEW 2: App Shell -->
  <div class="app-shell" id="app-shell" hidden>
    <aside class="app-sidebar" id="sidebar">
      <div class="app-sidebar__brand">
        <img src="public/brand/master/app-icon-v3.svg" alt="" class="app-sidebar__brand-symbol">
        <div class="app-sidebar__brand-text">
          <span class="app-sidebar__brand-name">LUMIÈRE</span>
          <span class="app-sidebar__brand-tagline">Life Manager</span>
        </div>
      </div>
      <nav class="app-sidebar__nav" aria-label="Navegação principal">

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Principal</h3>
          <button class="app-nav-item is-active" data-page="overview" type="button">
            <span class="app-nav-item__icon" data-icon="home"></span>
            <span class="app-nav-item__label">Início</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Acesso Rápido</h3>
          <button class="app-nav-item" data-page="tasks" type="button">
            <span class="app-nav-item__icon" data-icon="check"></span>
            <span class="app-nav-item__label">Tarefas</span>
          </button>
          <button class="app-nav-item" data-page="habits" type="button">
            <span class="app-nav-item__icon" data-icon="refresh"></span>
            <span class="app-nav-item__label">Hábitos</span>
          </button>
          <button class="app-nav-item" data-page="studies" type="button">
            <span class="app-nav-item__icon" data-icon="book"></span>
            <span class="app-nav-item__label">Estudos</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Organização</h3>
          <button class="app-nav-item" data-page="goals" type="button">
            <span class="app-nav-item__icon" data-icon="target"></span>
            <span class="app-nav-item__label">Objetivos</span>
          </button>
          <button class="app-nav-item" data-page="calendar" type="button">
            <span class="app-nav-item__icon" data-icon="calendar"></span>
            <span class="app-nav-item__label">Calendário</span>
          </button>
          <button class="app-nav-item" data-page="notes" type="button">
            <span class="app-nav-item__icon" data-icon="note"></span>
            <span class="app-nav-item__label">Notas</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Finanças</h3>
          <button class="app-nav-item" data-page="finances" type="button">
            <span class="app-nav-item__icon" data-icon="dollar"></span>
            <span class="app-nav-item__label">Finanças</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Negócio</h3>
          <button class="app-nav-item" data-page="lumiere" type="button">
            <span class="app-nav-item__icon" data-icon="diamond"></span>
            <span class="app-nav-item__label">Lumiere</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Análise</h3>
          <button class="app-nav-item" data-page="reports-card" type="button">
            <span class="app-nav-item__icon" data-icon="chart"></span>
            <span class="app-nav-item__label">Relatórios</span>
          </button>
        </div>

        <div class="app-nav-section">
          <h3 class="app-nav-section__title">Sistema</h3>
          <button class="app-nav-item" data-page="settings" type="button">
            <span class="app-nav-item__icon" data-icon="settings"></span>
            <span class="app-nav-item__label">Configurações</span>
          </button>
        </div>

      </nav>
      <div class="app-sidebar__footer">
        <button class="app-sidebar__profile" type="button" id="btn-profile">
          <span class="app-sidebar__avatar" id="sidebar-avatar">EM</span>
          <span class="app-sidebar__profile-info">
            <span class="app-sidebar__profile-name" id="sidebar-user-name">Utilizador</span>
            <span class="app-sidebar__profile-link">Meu progresso →</span>
          </span>
        </button>
      </div>
    </aside>

    <div class="app-main">
      <header class="app-topbar">
        <button class="app-topbar__toggle" id="btn-toggle" aria-label="Alternar sidebar">
          <svg class="app-topbar__toggle-icon" viewBox="0 0 18 15" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="1" y1="1" x2="17" y2="1"/>
            <line x1="1" y1="7.5" x2="17" y2="7.5"/>
            <line x1="1" y1="14" x2="17" y2="14"/>
          </svg>
        </button>
        <div class="app-topbar__brand">
          <img src="public/brand/master/app-icon-v3.svg" alt="" class="app-topbar__brand-symbol">
          <div class="app-topbar__brand-text">
            <span class="app-topbar__brand-name">LUMIÈRE</span>
            <span class="app-topbar__brand-tagline">
              <span class="app-topbar__brand-line" aria-hidden="true"></span>
              <span class="app-topbar__brand-tagline-text">Life Manager</span>
              <span class="app-topbar__brand-line" aria-hidden="true"></span>
            </span>
          </div>
        </div>
        <div class="app-topbar__actions">
          <button class="app-topbar__action app-topbar__action--bell" type="button" id="btn-bell" aria-label="Notificações">
            <span class="app-topbar__action-icon" data-icon="bell"></span>
            <span class="app-topbar__badge" aria-hidden="true"></span>
          </button>
          <span class="app-topbar__divider" aria-hidden="true"></span>
          <button class="app-topbar__user" type="button" id="topbar-user" aria-label="Perfil">
            <span class="app-topbar__avatar" id="topbar-avatar">U</span>
            <span class="app-topbar__user-name" id="topbar-user-name">Utilizador</span>
          </button>
        </div>
      </header>

      <!-- Painel de Notificações (Pendente 1) -->
      <div class="app-notif" id="notif-panel" hidden role="dialog" aria-label="Notificações">
        <div class="app-notif__header">
          <span class="app-notif__title-h">Notificações</span>
        </div>
        <ul class="app-notif__list" id="notif-list"></ul>
        <p class="app-notif__empty" id="notif-empty" hidden>Sem lembretes pendentes.</p>
      </div>
      <main class="app-content" id="content" aria-label="Conteúdo da página"></main>
    </div>


    <!-- Bottom nav (mobile) — P3.1 -->
    <nav class="app-bottom-nav" id="bottom-nav" aria-label="Navegação inferior">
      <button class="app-bottom-nav__item is-active" data-page="overview" type="button">
        <span class="app-bottom-nav__icon" data-icon="home"></span>
        <span class="app-bottom-nav__label">Início</span>
      </button>
      <button class="app-bottom-nav__item" data-page="habits" type="button">
        <span class="app-bottom-nav__icon" data-icon="refresh"></span>
        <span class="app-bottom-nav__label">Hábitos</span>
      </button>
      <button class="app-bottom-nav__item" data-page="progress" type="button">
        <span class="app-bottom-nav__icon" data-icon="chart"></span>
        <span class="app-bottom-nav__label">Progresso</span>
      </button>
      <button class="app-bottom-nav__item" data-page="today" type="button">
        <span class="app-bottom-nav__icon" data-icon="calendar"></span>
        <span class="app-bottom-nav__label">Hoje</span>
      </button>
      <button class="app-bottom-nav__item" type="button" id="bottom-nav-more">
        <span class="app-bottom-nav__icon" data-icon="more"></span>
        <span class="app-bottom-nav__label">Mais</span>
      </button>
    </nav>

    <div class="app-overlay" id="overlay"></div>
  </div>

  <script type="importmap">
    {
      "imports": {
        "dexie": "./vendor/dexie.mjs"
      }
    }
  </script>
  <script type="module" src="js/app.js"></script>

  <script>
    (function() {
      var savedName = localStorage.getItem('lumiereUserName');
      if (savedName) {
        document.getElementById('app').hidden = true;
        document.getElementById('app-shell').hidden = false;
        console.log('[Onboarding] Utilizador encontrado:', savedName);
        return;
      }

      var steps = {
        1: document.getElementById('step-1'),
        2: document.getElementById('step-2'),
        3: document.getElementById('step-3'),
        4: document.getElementById('step-4')
      };
      var userData = { name: '', theme: 'noir', gold: 'balanced', size: 'balanced' };

      function showStep(n) {
        Object.values(steps).forEach(function(el) { el.classList.remove('active'); });
        steps[n].classList.add('active');
      }

      document.getElementById('btn-start').addEventListener('click', function() { showStep(2); });

      document.getElementById('btn-name').addEventListener('click', function() {
        var name = document.getElementById('userName').value.trim();
        if (!name) {
          document.getElementById('nameError').style.display = 'block';
          return;
        }
        document.getElementById('nameError').style.display = 'none';
        userData.name = name;
        showStep(3);
      });

      document.getElementById('btn-personalize').addEventListener('click', function() {
        userData.theme = document.getElementById('theme').value;
        userData.gold = document.getElementById('goldIntensity').value;
        userData.size = document.getElementById('interfaceSize').value;
        var summary = document.getElementById('summary');
        summary.innerHTML =
          '<div class="summary-item"><span>Nome</span><span>' + userData.name + '</span></div>' +
          '<div class="summary-item"><span>Tema</span><span>' + userData.theme + '</span></div>' +
          '<div class="summary-item"><span>Dourado</span><span>' + userData.gold + '</span></div>' +
          '<div class="summary-item"><span>Tamanho</span><span>' + userData.size + '</span></div>';
        showStep(4);
      });

      document.getElementById('btn-finish').addEventListener('click', function() {
        localStorage.setItem('lumiereUserName', userData.name);
        localStorage.setItem('lumierePreferences', JSON.stringify({
          theme: userData.theme,
          goldIntensity: userData.gold,
          interfaceSize: userData.size
        }));
        document.getElementById('app').hidden = true;
        document.getElementById('app-shell').hidden = false;
        document.dispatchEvent(new CustomEvent('onboarding:complete'));
        console.log('[Onboarding] Concluido. Bem-vindo,', userData.name);
      });

      document.getElementById('userName').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') document.getElementById('btn-name').click();
      });
    })();
  </script>
  <!-- DBG removido na Fase 12. Para reativar: <script src="js/debug-panel.js"></script> -->
  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function() {
        // Limpar registos antigos e caches antigas
        navigator.serviceWorker.getRegistrations().then(function(regs) {
          return Promise.all(regs.map(function(r) { return r.unregister(); }));
        }).then(function() {
          return caches.keys();
        }).then(function(keys) {
          return Promise.all(keys.map(function(k) { return caches.delete(k); }));
        }).then(function() {
          // Registar o novo
          return navigator.serviceWorker.register("./sw.js");
        }).then(function(reg) {
          console.log("[SW] Registado:", reg.scope);
        }).catch(function(err) {
          console.error("[SW] Erro:", err);
        });
      });
    }
  </script>
</body>
</html>
